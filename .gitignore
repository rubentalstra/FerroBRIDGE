# Generated by Cargo
# will have compiled files and executables
/debug
/target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Claude Code personal/local overrides (never committed)
.claude/settings.local.json

# Claude Code agent worktrees (isolated per-agent checkouts, never committed)
.claude/worktrees/

# The rendered book (the mdBook build-dir) and the assembled site.
# .github/workflows/docs.yml renders both in CI.
/website/book/book/
/_site/

# The container build context: the release lane stages one static binary per
# platform under dist/<os>_<arch>/ and docker/Dockerfile copies it
# (docs/release.md). Built artefacts, never committed.
/dist/

# The quickstart's operator-provided directories (compose.yaml): the secret
# files the services read, and the OHDSI Athena vocabulary export the vocab
# profile bind-mounts. Neither ever enters this repository.
/secrets/
/vocabulary/

# The CycloneDX documents cargo-cyclonedx writes beside each member's
# Cargo.toml. The release lane renames the one it ships and uploads it as a
# release asset (docs/release.md); a local rehearsal leaves the rest behind.
*.cdx.json

# The fuzz crate builds outside the workspace; its build tree, corpora and
# crash artifacts never enter the repository (#155).
fuzz/target/
fuzz/corpus/
fuzz/artifacts/
fuzz/coverage/

# The HL7 v2 definitions scripts/vendor/v2ig.sh fetches at build time. Their
# terms do not permit redistribution, so nothing in the directory is ever
# committed except the PROVENANCE.md that records them
# (.claude/rules/vendored-inputs.md).
/tools/fhir-codegen/vendor/hl7-v2ig/*
!/tools/fhir-codegen/vendor/hl7-v2ig/PROVENANCE.md

# The HL7 v2 message sets scripts/vendor/hl7v2-samples.sh --build-time fetches.
# Neither repository grants redistribution, so only each PROVENANCE.md is
# committed (.claude/rules/vendored-inputs.md).
/crates/ferrobridge-hl7v2/vendor/nist/*
!/crates/ferrobridge-hl7v2/vendor/nist/PROVENANCE.md
/crates/ferrobridge-hl7v2/vendor/aira-mqe/*
!/crates/ferrobridge-hl7v2/vendor/aira-mqe/PROVENANCE.md
